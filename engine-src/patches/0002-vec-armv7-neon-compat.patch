diff --git a/Rapfi/eval/simd/vec.h b/Rapfi/eval/simd/vec.h
index eb90586..bb03667 100644
--- a/Rapfi/eval/simd/vec.h
+++ b/Rapfi/eval/simd/vec.h
@@ -25,6 +25,114 @@
 #include <tuple>
 #include <type_traits>
 
+/// The NEON kernels below are written against AArch64, using the double-width
+/// forms of some intrinsics (vuzp1q/vuzp2q, vmull_high_*, vqmovn_high_*,
+/// vpaddq_*, vpadalq_*, vaddvq_*). 32-bit ARM has no such forms, so define
+/// equivalents built from the intrinsics it does have. This keeps the
+/// instruction set selection unchanged (USE_NEON) on both ARM variants.
+#if defined(USE_NEON) && !defined(__aarch64__)
+
+/// vuzp1q_<t> / vuzp2q_<t> from the `vuzpq_<t>` pair result, low and high halves.
+template <typename V>
+struct NeonUzpTraits;
+
+    #define RAPFI_NEON_UZP_TRAITS(VTYPE, XTYPE)                                             \
+        template <>                                                                         \
+        struct NeonUzpTraits<VTYPE>                                                         \
+        {                                                                                   \
+            static VTYPE low(VTYPE a, VTYPE b) { return vuzpq_##XTYPE(a, b).val[0]; }        \
+            static VTYPE high(VTYPE a, VTYPE b) { return vuzpq_##XTYPE(a, b).val[1]; }       \
+        };
+
+RAPFI_NEON_UZP_TRAITS(int8x16_t, s8)
+RAPFI_NEON_UZP_TRAITS(int16x8_t, s16)
+RAPFI_NEON_UZP_TRAITS(int32x4_t, s32)
+
+    #undef RAPFI_NEON_UZP_TRAITS
+
+static FORCE_INLINE int8x16_t vuzp1q_s8(int8x16_t a, int8x16_t b)
+{
+    return NeonUzpTraits<int8x16_t>::low(a, b);
+}
+static FORCE_INLINE int8x16_t vuzp2q_s8(int8x16_t a, int8x16_t b)
+{
+    return NeonUzpTraits<int8x16_t>::high(a, b);
+}
+static FORCE_INLINE int16x8_t vuzp1q_s16(int16x8_t a, int16x8_t b)
+{
+    return NeonUzpTraits<int16x8_t>::low(a, b);
+}
+static FORCE_INLINE int16x8_t vuzp2q_s16(int16x8_t a, int16x8_t b)
+{
+    return NeonUzpTraits<int16x8_t>::high(a, b);
+}
+
+/// vpaddq_<t>: adjacent-pair add.
+static FORCE_INLINE int16x8_t vpaddq_s16(int16x8_t a, int16x8_t b)
+{
+    return vcombine_s16(vpadd_s16(vget_low_s16(a), vget_high_s16(a)),
+                        vpadd_s16(vget_low_s16(b), vget_high_s16(b)));
+}
+static FORCE_INLINE int32x4_t vpaddq_s32(int32x4_t a, int32x4_t b)
+{
+    return vcombine_s32(vpadd_s32(vget_low_s32(a), vget_high_s32(a)),
+                        vpadd_s32(vget_low_s32(b), vget_high_s32(b)));
+}
+
+/// vqmovn_high_<t> / vqmovun_high_<t>: saturating-narrow each operand to half width
+/// and concatenate. The AArch64 forms take the already-narrowed low half, so accept
+/// both the full-width and pre-narrowed first operand via overloads.
+static FORCE_INLINE int8x16_t vqmovn_high_s16(int8x8_t lo, int16x8_t b)
+{
+    return vcombine_s8(lo, vqmovn_s16(b));
+}
+static FORCE_INLINE int16x8_t vqmovn_high_s32(int16x4_t lo, int32x4_t b)
+{
+    return vcombine_s16(lo, vqmovn_s32(b));
+}
+static FORCE_INLINE uint8x16_t vqmovun_high_s16(uint8x8_t lo, int16x8_t b)
+{
+    return vcombine_u8(lo, vqmovun_s16(b));
+}
+static FORCE_INLINE uint16x8_t vqmovun_high_s32(uint16x4_t lo, int32x4_t b)
+{
+    return vcombine_u16(lo, vqmovun_s32(b));
+}
+
+/// vfmaq_f32: 32-bit ARM 通常没有融合乘加；用普通乘加兜底。
+/// 但 -mfpu=vfpv4 / armv8-a 等启用 __ARM_FEATURE_FMA 的目标上 arm_neon.h
+/// 会提供真·FMA 版本，此时必须让路，否则重定义编译失败。
+#if !defined(__ARM_FEATURE_FMA)
+static FORCE_INLINE float32x4_t vfmaq_f32(float32x4_t a, float32x4_t b, float32x4_t c)
+{
+    return vaddq_f32(a, vmulq_f32(b, c));
+}
+#endif
+
+/// vmull_high_<t>: multiply the high halves of two vectors, widening to the
+/// double-width element type, without needing the AArch64 2-source form.
+static FORCE_INLINE int16x8_t vmull_high_s8(int8x16_t a, int8x16_t b)
+{
+    return vmull_s8(vget_high_s8(a), vget_high_s8(b));
+}
+static FORCE_INLINE int32x4_t vmull_high_s16(int16x8_t a, int16x8_t b)
+{
+    return vmull_s16(vget_high_s16(a), vget_high_s16(b));
+}
+
+/// vaddvq_<t>: horizontal sum of all lanes.
+static FORCE_INLINE int32_t vaddvq_s32(int32x4_t a)
+{
+    return vgetq_lane_s32(a, 0) + vgetq_lane_s32(a, 1) + vgetq_lane_s32(a, 2)
+           + vgetq_lane_s32(a, 3);
+}
+static FORCE_INLINE float vaddvq_f32(float32x4_t a)
+{
+    return vgetq_lane_f32(a, 0) + vgetq_lane_f32(a, 1) + vgetq_lane_f32(a, 2)
+           + vgetq_lane_f32(a, 3);
+}
+#endif
+
 /// Register-level SIMD primitives, specialized per instruction set (SSE/AVX2/AVX512/
 /// NEON/WASM_SIMD, with SCALAR delegating to SSE through simde's portable fallbacks):
 /// VecBatch (size/register bookkeeping), VecLoadStore, VecCvt (widening), VecPack
