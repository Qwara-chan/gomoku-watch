<?xml version="1.0" encoding="utf-8"?>
<!--
  图标前景层：与五子棋（main 分支）同一套设计语言——
  金底 + 厚棕网格 + 对角平面双子；围棋的区分度靠 5×5 网格与星位。
  网格 24..84 四周留边，石子落在交叉点上。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 网格：线位 24/39/54/69/84 -->
    <path
        android:strokeColor="#8D6E63"
        android:strokeWidth="3"
        android:pathData="M24,24 L84,24 M24,39 L84,39 M24,54 L84,54 M24,69 L84,69 M24,84 L84,84 M24,24 L24,84 M39,24 L39,84 M54,24 L54,84 M69,24 L69,84 M84,24 L84,84" />

    <!-- 星位（四星 + 天元），围棋盘的签名 -->
    <path
        android:fillColor="#8D6E63"
        android:pathData="M39,39 m-3,0 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0 M69,39 m-3,0 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0 M39,69 m-3,0 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0 M69,69 m-3,0 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0 M54,54 m-3,0 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0" />

    <!-- 白子（左上） -->
    <path
        android:fillColor="#FAFAFA"
        android:pathData="M39,39 m-7.5,0 a7.5,7.5 0 1,1 15,0 a7.5,7.5 0 1,1 -15,0" />

    <!-- 黑子（右下） -->
    <path
        android:fillColor="#212121"
        android:pathData="M69,69 m-7.5,0 a7.5,7.5 0 1,1 15,0 a7.5,7.5 0 1,1 -15,0" />
</vector>
