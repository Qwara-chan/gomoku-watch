<?xml version="1.0" encoding="utf-8"?>
<!--
  图标前景层：与五子棋（main 分支）同一套设计语言——金底盘 + 厚棕网格 + 平面石子，
  围棋的辨识度放在「星位」上：网格 24/39/54/69/84（沿用家族留边），星位与天元就落在
  39/54/69 三条线交叉处。四颗星位各占一子（黑主对角、白副对角），天元特意留空，
  于是构图是一个点对称的四星布局——五子棋（main 分支）那颗是四路线、两子对角、不画星位，
  两面并排放在表盘列表里一眼可分。
  天元星用比网格深一号的棕（#6E4F33，即主题里的 WoodBrownEdge）压住圆心，
  与网格（#8D6E63）、石子（#212121/#FAFAFA）形成三级层次。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 网格：横竖线位 24/39/54/69/84 -->
    <path
        android:strokeColor="#8D6E63"
        android:strokeWidth="3"
        android:pathData="M24,24 L84,24 M24,39 L84,39 M24,54 L84,54 M24,69 L84,69 M24,84 L84,84 M24,24 L24,84 M39,24 L39,84 M54,24 L54,84 M69,24 L69,84 M84,24 L84,84" />

    <!-- 天元星位（54,54）：留空不落子，用深棕点出围棋的圆心 -->
    <path
        android:fillColor="#6E4F33"
        android:pathData="M54,54 m-5.5,0 a5.5,5.5 0 1,1 11,0 a5.5,5.5 0 1,1 -11,0" />

    <!-- 黑子：主对角两颗星位 (39,39)/(69,69) -->
    <path
        android:fillColor="#212121"
        android:pathData="M39,39 m-7.2,0 a7.2,7.2 0 1,1 14.4,0 a7.2,7.2 0 1,1 -14.4,0 M69,69 m-7.2,0 a7.2,7.2 0 1,1 14.4,0 a7.2,7.2 0 1,1 -14.4,0" />

    <!-- 白子：副对角两颗星位 (69,39)/(39,69) -->
    <path
        android:fillColor="#FAFAFA"
        android:pathData="M69,39 m-7.2,0 a7.2,7.2 0 1,1 14.4,0 a7.2,7.2 0 1,1 -14.4,0 M39,69 m-7.2,0 a7.2,7.2 0 1,1 14.4,0 a7.2,7.2 0 1,1 -14.4,0" />
</vector>
